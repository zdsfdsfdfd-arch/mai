# Пример конфигурации nginx для статического сайта ФБСР.
# Замените example.ru на ваш домен, а /var/www/fbsr — на путь к файлам сайта.

server {
    listen 80;
    listen [::]:80;
    server_name example.ru www.example.ru;
    return 301 https://example.ru$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name example.ru;

    # Сертификат: Let's Encrypt (certbot) или сертификат от российского УЦ
    ssl_certificate     /etc/letsencrypt/live/example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/fbsr;
    index index.html;
    charset utf-8;

    # Красивые адреса: /competitions -> competitions.html
    location / {
        try_files $uri $uri.html $uri/ =404;
    }
    error_page 404 /404.html;

    # Кэширование статики
    location ~* \.(css|js|svg|woff2|png|jpg|jpeg|webp|ico)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    # Сжатие
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Базовые заголовки безопасности
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # CSP: разрешаем свои ресурсы и Яндекс.Метрику (подключается только после согласия на cookie)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://mc.yandex.ru 'unsafe-inline'; img-src 'self' data: https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://mc.yandex.ru; frame-src https://rutube.ru https://vk.com https://vkvideo.ru https://yandex.ru; frame-ancestors 'self'" always;
}

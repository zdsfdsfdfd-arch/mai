  "scenes": [
    {
      "id": "s01",
      "type": "title_card",
      "narration": "У каждого человека есть проблемы. У кого-то деньги. У кого-то работа. А у меня *сосед снизу*.",
      "props": { "title": "СОСЕД СНИЗУ", "subtitle": "ДОМ · 9 ЭТАЖ · НОЧЬ" },
      "character": { "pose": "stand" },
      "tension": 0.3
    },
    {
      "id": "s02",
      "type": "building_cutaway",
      "narration": "Я живу на девятом. Он на восьмом. Тихий человек. Одна странность: он !очень любит барашков!.",
      "props": { "floors": 12, "cabinBetween": [8, 9], "highlight": [8, 9], "litWindows": [], "hud": { "label": "ЭТАЖ", "value": "9 / 8", "tone": "yellow" }, "noCabin": true },
      "topPlaque": { "num": "", "text": "ДОМ · 12 ЭТАЖЕЙ" },
      "tension": 0.35
    },
    {
      "id": "s03",
      "type": "sound_diagram",
      "narration": "Каждую ночь снизу: *топот копыт*. *Блеяние*. И громкие разговоры с кем-то, кто отвечает только !бе-е-е!.",
      "props": { "floors": [7, 8, 9, 10], "cabinBetween": [8, 9], "reach": [9, 10], "label": "02:10 · ТОПОТ · 02:40 · БЛЕЯНИЕ", "source": "floor" },
      "topPlaque": { "num": "1", "text": "ЗВУКИ" },
      "tension": 0.45
    },
    {
      "id": "s04",
      "type": "stat_callouts",
      "narration": "Я начал собирать улики. Улика один: *шерсть* в лифте. Улика два: мешок сена, который сосед нёс так, будто это ноутбук. Улика три: морковка у моей двери с запиской !«извините, этаж перепутали»!.",
      "props": {
        "heading": "УЛИКИ",
        "cards": [
          { "label": "УЛИКА 1", "value": "ШЕРСТЬ", "at": 1.5 },
          { "label": "УЛИКА 2", "value": "СЕНО", "at": 4.0, "tone": "yellow" },
          { "label": "УЛИКА 3", "value": "МОРКОВКА", "at": 7.5, "tone": "red" }
        ],
        "diagram": "lift"
      },
      "topPlaque": { "num": "2", "text": "УЛИКИ" },
      "tension": 0.5
    },
    {
      "id": "s05",
      "type": "character_scene",
      "narration": "Я спустился и постучал. Слушай, у тебя там что, *ферма*? Нет-нет. Всего *один* барашек.",
      "props": { "setting": "door", "light": "dim" },
      "character": { "pose": "knock" },
      "status": "ДВЕРЬ · 8 ЭТАЖ",
      "tension": 0.5
    },
    {
      "id": "s06",
      "type": "character_scene",
      "narration": "В этот момент из квартиры раздалось !бе-е-е!. И мимо двери пробежали *три* овцы.",
      "props": { "setting": "door", "light": "dim", "sheep": [{ "at": 1.2, "color": "white" }, { "at": 1.6, "color": "white" }, { "at": 2.0, "color": "black" }] },
      "character": { "pose": "stand" },
      "status": "!ОДИН БАРАШЕК × 3",
      "tension": 0.6
    },
    {
      "id": "s07",
      "type": "floor_plan",
      "narration": "На следующее утро я проснулся от звука. Кто-то *жевал* мой фикус.",
      "props": { "rooms": ["КОМНАТА", "КОРИДОР", "КУХНЯ"], "marks": [{ "text": "Я", "room": 0 }, { "text": "ФИКУС", "room": 0, "sheep": true }], "time": "06:40" },
      "topPlaque": { "num": "", "text": "ДЕНЬ 2 · 06:40" },
      "tension": 0.5
    },
    {
      "id": "s08",
      "type": "character_scene",
      "narration": "Посреди комнаты стоял *барашек*. Спокойный. Как будто это его комната, а я тут временно.",
      "props": { "setting": "room", "light": "day", "sheep": [{ "at": 0.3, "color": "white", "idle": true }] },
      "character": { "pose": "sit" },
      "status": "ГОСТЬ · БЕЛЫЙ",
      "tension": 0.55
    },
    {
      "id": "s09",
      "type": "dialogue",
      "narration": "Я позвонил соседу. !Твой баран у меня дома!. Какой? В смысле *какой*? Белый или *чёрный*?",
      "props": { "callTo": "СОСЕД", "lines": [{ "side": "me", "text": "ТВОЙ БАРАН У МЕНЯ ДОМА!" }, { "side": "him", "text": "Какой?" }, { "side": "me", "text": "В СМЫСЛЕ КАКОЙ?!" }, { "side": "him", "text": "Белый или чёрный?" }] },
      "status": "ВЫЗОВ · СОСЕД",
      "tension": 0.7
    },
    {
      "id": "s10",
      "type": "character_scene",
      "narration": "Я медленно повернулся к коридору. Из коридора вышел *второй*.",
      "props": { "setting": "room", "light": "day", "sheep": [{ "at": 0.2, "color": "white", "idle": true }, { "at": 1.6, "color": "black", "fromLeft": true }] },
      "character": { "pose": "sit" },
      "status": "!БЕЛЫЙ И ЧЁРНЫЙ",
      "tension": 0.8
    },
    {
      "id": "s11",
      "type": "stat_callouts",
      "narration": "Я принял единственное взрослое решение. *Переехать*. Два чемодана. Лифт. Первый этаж.",
      "props": {
        "heading": "ПЛАН",
        "cards": [
          { "label": "ВЕЩИ", "value": "2 ЧЕМ.", "at": 1.2 },
          { "label": "ЛИФТ", "value": "9 → 1", "at": 2.4, "tone": "yellow" },
          { "label": "ПЛАН", "value": "УЕХАТЬ", "at": 3.6, "tone": "green" }
        ],
        "diagram": "lift"

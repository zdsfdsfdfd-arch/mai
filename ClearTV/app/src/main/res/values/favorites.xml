<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Apps the owner asked to keep on the home row, in this order. Each line: label keywords (lower case,
      separated by |) = package candidates (in order of preference). The first installed candidate wins; when
      none is installed the keywords are matched against the visible labels. Apps that are not installed are
      simply skipped and appear automatically once installed (while the row is in automatic mode).
      Mirrored for the PC scripts in scripts/data/preferred-apps.json (clean.ps1 never touches these).
    -->
    <string-array name="preferred_apps" translatable="false">
        <item>youtube|ютуб|smarttube=com.google.android.youtube.tv,com.google.android.youtube,org.smarttube.stable,org.smarttube.beta,app.smarttube,app.smarttube.fdroid,com.teamsmart.videomanager.tv,com.liskovsoft.smarttubetv.beta,ru.sberdevices.startube</item>
        <item>netflix=com.netflix.ninja,com.netflix.mediaclient,web:netflix</item>
        <item>hbo max|hbo=com.wbd.stream,com.hbo.hbonow,eu.hbogo.androidtv,com.hbo.go,web:hbomax</item>
        <item>apple tv=com.apple.atve.androidtv.appletv,com.apple.atve.sony.appletv,com.apple.atve.amazon.appletv,web:appletv</item>
        <item>spotify=com.spotify.tv.android,com.spotify.music,com.spotify.lite,web:spotify</item>
        <item>happ=su.happ.proxyutility,com.happproxy</item>
        <item>twitch=tv.twitch.android.app,tv.twitch.android.viewer,web:twitch</item>
        <item>rutube=ru.rutube.app,ru.rutube.tv</item>
        <item>vk видео|вк видео|vk video=com.vk.tv,com.vk.vkvideo</item>
        <item>chrome|браузер|browser=com.android.chrome,com.chrome.beta,ru.sberdevices.starbrowser</item>
    </string-array>

    <!--
      Web versions shown as cards while the real app is not installed: id=label=url=brand colour. The card opens the
      address in the TV's browser. Whether the service plays in that browser (DRM, region, account) is up to the
      service; the card never pretends otherwise — its artwork says "web version".
    -->

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- bottom scrim keeps the rows legible on bright wallpapers -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#E60E1013" android:centerColor="#6E0E1013" android:centerY="0.45" android:endColor="#000E1013" />
        </shape>
    </item>
    <!-- soft left scrim behind the clock -->
    <item android:right="420dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#7A0E1013" android:endColor="#000E1013" />
        </shape>
    </item>
</layer-list>
